# ---------- Server ----------
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contractdb

# ---------- Providers ----------
# LLM_PROVIDER:   mock | openai | gemini | anthropic
# EMBED_PROVIDER: mock | openai | gemini        (Anthropic has no embeddings API)
# Start with "mock" for both: no API keys needed, the full pipeline still runs.
LLM_PROVIDER=mock
EMBED_PROVIDER=mock

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model names (change if your provider has newer ones)
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
ANTHROPIC_LLM_MODEL=claude-sonnet-5-5

# ---------- Pipeline tuning ----------
TOP_K=4                 # policies sent to the LLM per clause
CONCURRENCY=3           # clauses analysed in parallel
MIN_CONFIDENCE=0.6      # findings below this are routed to "needs review"
